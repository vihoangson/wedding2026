# File này đặt tên là .env trên VM, cùng thư mục với docker-compose.yml
# (khác với .env của Laravel - .env của Laravel được mount riêng, xem README)

DOCKERHUB_USER=your-dockerhub-username
TAG=latest

DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password
